# Copy to .env.local (never commit real values)

# Public site origin — used for canonical URLs, hreflang alternates and Open Graph
NEXT_PUBLIC_SITE_URL=https://dukaat.example

# Intake e-mail behind the eight routers (Resend REST API). Leave unset until the own domain exists:
# the form then tells the visitor the mailbox is not configured yet and shows the correspondence address.
RESEND_API_KEY=
INTAKE_TO=
# Optional — must be a sender on a domain verified in Resend
INTAKE_FROM="DUKAAT intake <intake@dukaat.example>"

# Photo generation (npm run photos) — Gemini API key from aistudio.google.com, same models as Google Flow
GEMINI_API_KEY=

# Copy to .env.local (never commit real values)

# Public site origin — canonical URLs, hreflang alternates, Open Graph, robots.txt and sitemap.xml (lib/site-url.ts).
# Optional: unset, a production build uses https://www.dukaatbusinessclub.com and development uses http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Intake e-mail behind the eight routers (Resend REST API, app/actions/forms.ts). The one thing that has to be set is the key:
# without it every form tells the visitor the request could not be sent and shows the club's e-mail address and telephone.
RESEND_API_KEY=
# Optional — default: contact@dukaatbusinessclub.com (content/contact-details.ts)
INTAKE_TO=
# Optional — default: DUKAAT <intake@dukaatbusinessclub.com>; must be a sender on a domain verified in Resend
INTAKE_FROM=

# Photo generation (npm run photos) — Gemini API key from aistudio.google.com, same models as Google Flow
GEMINI_API_KEY=
